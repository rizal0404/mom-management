    "test:e2e": "node scripts/test-e2e.mjs",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.12",
